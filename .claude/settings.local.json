{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "docker compose down && docker compose build && docker compose up -d",
            "shell": "bash",
            "async": true,
            "statusMessage": "Rebuilding Docker...",
            "timeout": 300
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
