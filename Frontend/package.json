{
  "name": "frontend",
  "private": true,
  "version": "1.1.4",
  "description": "Sistema de operación Casa Verde — pedidos, inventario, caja y cuentas por cobrar",
  "author": "Harold Velasquez",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "electron:dev": "concurrently \"npm run dev\" \"electron .\"",
    "build:react": "vite build",
    "build:react:electron": "vite build --mode electron",
    "build:electron": "npm run build:react:electron && electron-builder",
    "publish:electron": "npm run build:react:electron && electron-builder --publish always",
    "build:web": "npm run build:react",
    "electron": "electron .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-query": "^5.100.9",
    "axios": "^1.16.0",
    "date-fns": "^4.1.0",
    "electron-updater": "^6.8.3",
    "lucide-react": "^1.14.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.75.0",
    "react-router-dom": "^7.15.0",
    "tailwindcss": "^4.3.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/coverage-v8": "^4.1.7",
    "concurrently": "^9.2.0",
    "electron": "^42.3.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^29.1.1",
    "vite": "^7.0.4",
    "vitest": "^4.1.7"
  },
  "build": {
    "appId": "com.casaverde.casaverde",
    "productName": "Casa Verde",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/backend.jar",
        "to": "backend.jar"
      },
      {
        "from": "resources/jre",
        "to": "jre",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/update-config.json",
        "to": "update-config.json"
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "Harold-V",
      "repo": "Casa-Verde",
      "private": true,
      "releaseType": "release"
    },
    "directories": {
      "buildResources": "assets",
      "output": "dist-electron"
    },
    "win": {
      "target": "nsis",
      "forceCodeSigning": false,
      "signtoolOptions": {
        "sign": "./electron/sign.cjs"
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
